{
  "name": "ui-music",
  "purpose": "音乐面板：工程信息/五线谱/钢琴卷帘/试听/轨道表/7 项校验结果（数据来自 tool-music 的工程与旁挂报告）",
  "version": "0.1.0",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "sidebar",
      "kind": "list",
      "scope": "root",
      "inject": [
        "@paircode/core"
      ],
      "immediately": false,
      "build": {
        "entry": "src/ui-main-music.js",
        "global": "MusicPanel",
        "outDir": "plugins-dist/ui-music/assets",
        "fileName": "music-panel"
      }
    }
  },
  "keywords": [
    "paircode"
  ],
  "license": "MIT"
}
