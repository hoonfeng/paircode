{
  "name": "ui-art",
  "purpose": "矢量画板面板：SVG 预览 / 图元与图层 / 颜色对比度 / 7 项校验 / 浏览器导出 PNG（数据来自 tool-art 的工程与旁挂报告）",
  "version": "0.1.0",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "sidebar",
      "kind": "list",
      "scope": "root",
      "inject": [
        "@paircode/core"
      ],
      "immediately": false,
      "build": {
        "entry": "src/ui-main-art.js",
        "global": "ArtPanel",
        "outDir": "plugins-dist/ui-art/assets",
        "fileName": "art-panel"
      }
    }
  },
  "keywords": [
    "paircode"
  ],
  "license": "MIT"
}
