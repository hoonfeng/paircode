{
  "name": "ui-sidebar",
  "purpose": "文件/搜索/Git/插件 四面板侧栏",
  "version": "0.1.0",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "sidebar",
      "kind": "single",
      "scope": "root",
      "inject": ["@paircode/core"],
      "immediately": true,
      "build": {
        "entry": "src/ui-main-sidebar.js",
        "global": "UiSidebar",
        "outDir": ".pair/plugins/ui-sidebar/assets",
        "fileName": "ui-sidebar"
      }
    }
  }
}
