{
  "name": "ui-right-panel",
  "purpose": "对话面板（含 chat/chat-tools 叠加挂载）",
  "version": "0.1.0",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "conversation",
      "kind": "single",
      "scope": "root",
      "inject": ["@paircode/core", "@paircode/layout"],
      "immediately": true,
      "build": {
        "entry": "src/ui-main-right-panel.js",
        "global": "UiRightPanel",
        "outDir": ".pair/plugins/ui-right-panel/assets",
        "fileName": "ui-right-panel"
      }
    }
  }
}
