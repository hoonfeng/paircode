{
  "name": "ui-statusbar",
  "purpose": "工作区/git/文件信息 + statusbar-items 叠加挂载",
  "version": "0.1.0",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "statusbar",
      "kind": "single",
      "scope": "root",
      "inject": ["@paircode/core"],
      "immediately": true,
      "build": {
        "entry": "src/ui-main-statusbar.js",
        "global": "UiStatusbar",
        "outDir": ".pair/plugins/ui-statusbar/assets",
        "fileName": "ui-statusbar"
      }
    }
  }
}
