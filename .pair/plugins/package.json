{
  "name": "paircode-plugins",
  "private": true,
  "version": "1.3.0",
  "description": "PairCode 插件体系发布包：全部磁盘插件（agentloop/core-api/tool-*/ui-*/web-api）+ UI 源码工程（ui-app-src）+ 依赖模型清单（config/models.json）",
  "keywords": [
    "paircode",
    "plugins",
    "ai-coding",
    "ide"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node ../../scripts/build-ui.mjs",
    "build:shell": "cd ui-app-src && npm run build",
    "pack": "npm pack --pack-destination ../../release",
    "version:bump": "npm version --no-git-tag-version"
  },
  "files": [
    "README.md",
    "agentloop",
    "core-api",
    "web-api",
    "tool-binary",
    "tool-bug",
    "tool-codegraph",
    "tool-codegraph-extra",
    "tool-core",
    "tool-debug",
    "tool-git",
    "tool-harness",
    "tool-lsp",
    "tool-memory",
    "tool-office",
    "tool-project-info",
    "tool-screenshot",
    "tool-search",
    "tool-shell",
    "tool-system",
    "tool-verify",
    "tool-vision",
    "tool-web",
    "tool-web-debug",
    "ui-activitybar",
    "ui-editor",
    "ui-modals",
    "ui-right-panel",
    "ui-sidebar",
    "ui-statusbar",
    "ui-statusbar-conn",
    "ui-titlebar",
    "ui-app-src",
    "config/models.json",
    "config/settings.template.json"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/collab": "^6.1.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "pinia": "^4.0.1",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0"
  }
}
