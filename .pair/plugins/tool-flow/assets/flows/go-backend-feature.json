{
  "schemaVersion": 1,
  "id": "go-backend-feature",
  "title": "Go 后端功能开发",
  "version": 1,
  "projectTypes": [
    "go"
  ],
  "taskTypes": [
    "feature",
    "refactor",
    "bugfix"
  ],
  "appliesTo": {
    "types": [
      "go"
    ],
    "signals": [
      "go.mod",
      "go.work"
    ]
  },
  "stages": [
    {
      "id": "recon",
      "title": "调研与定位",
      "goal": "搞清代码结构与调用链，确定改动面",
      "gates": [
        {
          "id": "g-recon-1",
          "kind": "check",
          "text": "已列出受影响文件清单（含调用方）",
          "required": true,
          "blocking": true
        },
        {
          "id": "g-recon-2",
          "kind": "check",
          "text": "已确认调用链与影响面结论"
        }
      ],
      "plan": [
        {
          "subject": "搜索关键符号",
          "detail": "优先结构化符号搜索（函数/类型定义），记录命中文件与行"
        },
        {
          "subject": "读关键文件与调用链",
          "detail": "确认改动点上下文；用引用/影响分析查全调用方"
        },
        {
          "subject": "列受影响文件清单",
          "detail": "含调用方与测试文件；漏改调用方是最高频返工原因"
        }
      ]
    },
    {
      "id": "impl",
      "title": "实施修改",
      "goal": "按方案完成代码改动",
      "gates": [
        {
          "id": "g-impl-1",
          "kind": "check",
          "text": "改动已完成且与方案一致",
          "required": true
        }
      ],
      "plan": [
        {
          "subject": "按方案改代码",
          "detail": "最小改动 + 跟随既有风格（命名/错误处理/日志）"
        },
        {
          "subject": "同步调用方",
          "detail": "改了签名或行为，必须一并改所有调用点"
        },
        {
          "subject": "自查一致性",
          "detail": "diff 通读一遍：无调试残留、无无关格式变动"
        }
      ]
    },
    {
      "id": "build",
      "title": "编译",
      "goal": "编译通过，无新增告警",
      "gates": [
        {
          "id": "g-build-1",
          "kind": "command",
          "text": "go build ./... 通过",
          "cmd": "go build ./...",
          "required": true,
          "blocking": true,
          "onFail": "advise"
        }
      ],
      "plan": [
        {
          "subject": "go build ./...",
          "detail": "编译通过，零新增错误"
        },
        {
          "subject": "go vet ./...",
          "detail": "静态检查无新增告警"
        }
      ]
    },
    {
      "id": "test",
      "title": "测试",
      "goal": "受影响包的测试通过",
      "gates": [
        {
          "id": "g-test-1",
          "kind": "command",
          "text": "go test ./... 通过",
          "cmd": "go test ./...",
          "required": true,
          "blocking": true,
          "onFail": "rollback"
        }
      ],
      "plan": [
        {
          "subject": "跑受影响包测试",
          "detail": "go test ./<pkg>/... 全绿"
        },
        {
          "subject": "补必要用例",
          "detail": "覆盖新增分支与边界（缺用例的修复等于没修）"
        }
      ]
    },
    {
      "id": "deliver",
      "title": "交付",
      "goal": "汇总变更与验证证据",
      "gates": [
        {
          "id": "g-deliver-1",
          "kind": "approval",
          "text": "用户确认交付",
          "required": true,
          "blocking": true
        }
      ],
      "plan": [
        {
          "subject": "汇总改动文件",
          "detail": "列出改了哪些文件、各自作用"
        },
        {
          "subject": "记录验证命令与结果",
          "detail": "写清跑了什么命令、真实输出是什么（供复核）"
        }
      ]
    }
  ],
  "board": {
    "kind": "kanban",
    "columns": [
      "stage",
      "status"
    ],
    "fields": [
      "goal",
      "gates",
      "evidence"
    ],
    "groupBy": "stage"
  },
  "library": {
    "author": "paircode",
    "tags": [
      "go",
      "backend",
      "feature"
    ]
  }
}
