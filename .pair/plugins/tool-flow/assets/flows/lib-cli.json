{
  "schemaVersion": 1,
  "id": "lib-cli",
  "title": "库 / CLI 开发",
  "version": 1,
  "projectTypes": ["lib", "cli"],
  "taskTypes": ["feature", "api"],
  "appliesTo": { "types": ["lib", "cli"], "signals": ["Cargo.toml", "cmd/", "bin/"] },
  "stages": [
    {
      "id": "api",
      "title": "接口设计",
      "goal": "先定对外契约（签名/参数/退出码）",
      "tasks": ["定接口签名", "定错误语义"],
      "gates": [
        { "id": "g-api-1", "kind": "check", "text": "接口契约已明确（含错误与退出码语义）", "required": true, "blocking": true }
      ]
    },
    {
      "id": "impl",
      "title": "实现",
      "goal": "按契约实现",
      "tasks": ["实现主体", "实现参数解析"],
      "gates": [
        { "id": "g-impl-1", "kind": "check", "text": "实现与契约一致", "required": true }
      ]
    },
    {
      "id": "unit",
      "title": "单测",
      "goal": "核心路径与错误路径均有用例",
      "tasks": ["写单测", "跑测试"],
      "gates": [
        { "id": "g-unit-1", "kind": "command", "text": "单测通过", "cmd": "go test ./...", "required": true, "blocking": true, "onFail": "rollback" }
      ]
    },
    {
      "id": "doc",
      "title": "文档",
      "goal": "用法与示例可照抄运行",
      "tasks": ["写 README 用法", "补示例"],
      "gates": [
        { "id": "g-doc-1", "kind": "artifact", "text": "README 已更新（含可运行示例）", "artifact": "README.md", "required": true }
      ]
    }
  ],
  "board": { "kind": "timeline", "columns": ["stage", "status"], "fields": ["goal", "gates", "evidence"], "groupBy": "stage" },
  "library": { "author": "paircode", "tags": ["lib", "cli"] }
}
