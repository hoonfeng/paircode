{
  "name": "ui-titlebar",
  "purpose": "标题栏（titlebar 槽位）：logo/菜单/标题 + titlebar-right 叠加挂载",
  "version": "0.1.0",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "titlebar",
      "kind": "single",
      "scope": "root",
      "inject": ["@paircode/core"],
      "immediately": true,
      "build": {
        "entry": "src/ui-main-titlebar.js",
        "global": "UiTitlebar",
        "outDir": ".pair/plugins/ui-titlebar/assets",
        "fileName": "ui-titlebar"
      }
    }
  }
}
