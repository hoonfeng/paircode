{
  "name": "git-api",
  "purpose": "Git 接口插件化（17 条）+ Git 源代码管理面板（接口与 UI 一体化）",
  "version": "0.1.2",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "sidebar",
      "kind": "list",
      "scope": "root",
      "inject": ["@paircode/core"],
      "immediately": false,
      "build": {
        "entry": "src/ui-main-git.js",
        "global": "GitPanel",
        "outDir": ".pair/plugins/git-api/assets",
        "fileName": "git-panel"
      }
    }
  }
}
