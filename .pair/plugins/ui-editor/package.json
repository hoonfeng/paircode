{
  "name": "ui-editor",
  "purpose": "EditorArea + 底部终端面板 + 拖拽 resizer",
  "version": "0.1.0",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "editor",
      "kind": "single",
      "scope": "root",
      "inject": ["@paircode/core", "@paircode/layout"],
      "immediately": true,
      "build": {
        "entry": "src/ui-main-editor.js",
        "global": "UiEditor",
        "outDir": ".pair/plugins/ui-editor/assets",
        "fileName": "ui-editor"
      }
    }
  }
}
