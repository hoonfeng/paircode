{
  "name": "ui-activitybar",
  "purpose": "活动栏竖列（左侧图标导航 + activitybar 叠加挂载）",
  "version": "0.1.2",
  "scope": "global",
  "type": "plugin",
  "main": "index.js",
  "client": "client.js",
  "dsh": {
    "ui": {
      "platform": "web",
      "slot": "activitybar",
      "kind": "single",
      "scope": "root",
      "inject": ["@paircode/core"],
      "immediately": true,
      "build": {
        "entry": "src/ui-main-activitybar.js",
        "global": "UiActivitybar",
        "outDir": ".pair/plugins/ui-activitybar/assets",
        "fileName": "ui-activitybar"
      }
    }
  }
}
