# Pair CodeAgent 工作目录：仅入库插件（plugins/）与运行资产（assets/）；
# 其余（memory/conversations/tasks/skills/toolsets/execution_logs/publish 日志/
# pair.db/mcp.json/cordis.patch.json 等本地运行时敏感状态）一律不入库
.pair/*
!.pair/plugins/
!.pair/assets/

# IDE configurations
.trae/

# Local sensitive configs
config/settings.json
config/mcp.json
config/models.json
# 语义搜索模型（大体积发布资产，运行时下载/本地放置，不入库）
config/models/

# Generated runtime configs

# Temporary files
tmp/
_temp/

# Frontend dependencies (not committed)
node_modules/

# Reference code (not part of the build)
_codegraph_ref/

# Release artifacts
release/companion.exe
cmd/companion/config/

# Build artifacts
bin/*
!bin/bash/
!bin/bash/**/*.exe
!bin/bash/**/*.dll
release/

# Node build outputs
cmd/companion/web-ui/node_modules/
cmd/companion/web-ui/dist/

# Debug / temp files
_*.txt
_*.go
*.orig
*.bat
!scripts/build-plugin-bins.bat
.dbg/
debug-*.md
diag_*.txt
doag_*.txt
build_err.txt

# Python temporary scripts
*.py
__pycache__/
*.pyc
internal/agent/.pair/

# 探针脚本路径转义失误产生的镜像目录（F:\syproject\gou-ide → F:syprojectgou-ide）
syprojectgou-ide/

# PairCode 内置 bash（含 npm 登录凭据 .npmrc，禁止进仓库）
bin/bash/

# AgentTeams 团队运行时状态（不入库）
.agent-teams/

# 本地敏感配置（含 API key，禁止入库；发布侧经 packager stripSecrets 脱敏）
config/ai-presets.json
cmd/desktop/config/
dev/desktop_probe/config/

# 验证/探针临时产物（t3 验证日志 / dev 探针截图）
.verify-tmp/
dev/wsprobe/
# 独立验证临时日志.verify-tmp/

# Go build cache (380MB, local only)
.go-cache/
gocache/

# 桌面版归档（本版本不做桌面版——wb-ui/goskia 依赖移除；代码保留在 _desktop-archive/）
_desktop-archive/

# headless chrome 测试数据（cdp 验证临时）
.chrome-test/

# ─────────────────────────────────────────────────────────────
# ★ 构建产物（不入库；由构建脚本本地生成后使用）—— 2026-09-13 仓库重建
#   壳产物：cd plugins-src/ui-app && npm run build   → .pair/assets/runtime/web/
#   区域包：node scripts/build-ui.mjs [--region <id>]（各插件 package.json dsh.ui.build 声明输出）
#   cordis：见 .pair/assets/runtime/README.md「重建 cordis.bundle.js」章节
#   （favicon.svg 亦为构建拷贝产物：源 plugins-src/ui-app/public/favicon.svg）
# ─────────────────────────────────────────────────────────────
.pair/assets/runtime/web/
.pair/assets/runtime/cordis.bundle.js
.pair/plugins/*/assets/favicon.svg
.pair/plugins/git-api/assets/git-panel.js
.pair/plugins/git-api/assets/git-panel.css
.pair/plugins/marketplace/assets/marketplace-panel.js
.pair/plugins/marketplace/assets/marketplace-panel.css
.pair/plugins/ui-*/assets/ui-*.js
.pair/plugins/ui-*/assets/ui-*.css

# ── 历史误入库杂物防再犯（2026-09-13 重建清理项：# 调试二进制/测试产物/探针转储）──
__debug_bin*
desktop_test*
*_9090.json
**/dev/null
ws_trace.jsonl
nm*.txt
_probe_*
