{
  "version": "1.6.2",
  "appName": "PairCode IDE",
  "description": "AI-Powered Code Companion",
  "company": "PairCode",
  "copyright": "Copyright (C) 2026 PairCode",
  "vars": {
    "cgo": "1",
    "console": "true",
    "frontendDir": "cmd/companion/web-ui",
    "icon": "assets/icon.png",
    "mainPkg": "./cmd/companion",
    "output": "pair.exe",
    "targets": "windows/amd64,linux/amd64,darwin/arm64"
  },
  "pipeline": [
    {
      "name": "verify-dist-isolation",
      "command": "node scripts/verify-dist-isolation.mjs"
    },
    {
      "name": "build-ui-plugins",
      "command": "node scripts/build-ui.mjs"
    },
    {
      "name": "sync-plugins-to-bin",
      "command": "node scripts/sync-plugins-to-bin.mjs"
    },
    {
      "name": "build-ui-frontend",
      "command": "cd plugins-src/ui-app \u0026\u0026 npm run build"
    },
    {
      "name": "sync-embed-shell",
      "command": "node scripts/sync-web-dist.mjs"
    },
    {
      "name": "generate-icon",
      "command": "ffmpeg -y -i {{icon}} -s 256x256 cmd/companion/icon_256.png",
      "os": "windows",
      "ignoreError": true
    },
    {
      "name": "compile-resource",
      "command": "windres -i cmd/companion/companion.rc -o cmd/companion/companion.syso -O coff",
      "os": "windows",
      "ignoreError": true
    },
    {
      "name": "verify-release",
      "command": "node scripts/verify-release.mjs"
    },
    {
      "name": "build-go",
      "type": "build-go"
    },
    {
      "name": "package",
      "type": "package"
    }
  ],
  "dist": {
    "outputDir": "release",
    "dirName": "PairCode",
    "format": "zip",
    "include": [
      {
        "src": "README.md",
        "dst": "README.md",
        "optional": true
      },
      {
        "src": "config/skills",
        "dst": "config/skills",
        "optional": true,
        "recursive": true
      },
      {
        "src": "docs",
        "dst": "docs",
        "optional": true,
        "recursive": true
      },
      {
        "src": "assets/icon.svg",
        "dst": "assets/icon.svg",
        "optional": true
      },
      {
        "src": "assets/icon.png",
        "dst": "assets/icon.png",
        "optional": true
      },
      {
        "src": "assets/icon64.png",
        "dst": "assets/icon64.png",
        "optional": true
      },
      {
        "src": "assets/icon128.png",
        "dst": "assets/icon128.png",
        "optional": true
      },
      {
        "src": "lib/libSkiaSharp.dll",
        "dst": "lib/libSkiaSharp.dll",
        "optional": true
      },
      {
        "src": "bin/config/models.json",
        "dst": "bin/config/models.json",
        "optional": true
      },
      {
        "src": "bin/config/onnx/onnxruntime.dll",
        "dst": "bin/config/onnx/onnxruntime.dll",
        "optional": true,
        "os": "windows"
      },
      {
        "src": "bin/config/onnx/libonnxruntime.so",
        "dst": "bin/config/onnx/libonnxruntime.so",
        "optional": true,
        "os": "linux"
      },
      {
        "src": "bin/config/onnx/libonnxruntime.dylib",
        "dst": "bin/config/onnx/libonnxruntime.dylib",
        "optional": true,
        "os": "darwin"
      },
      {
        "src": ".pair/plugins",
        "dst": ".pair/plugins",
        "optional": true,
        "recursive": true,
        "exclude": [
          "tool-music",
          "tool-voice",
          "tool-art",
          "ui-music",
          "ui-voice",
          "ui-art",
          "tool-design",
          "ui-design",
          "tool-rig",
          "ui-rig",
          "tool-model",
          "ui-model"
        ]
      },
      {
        "src": "plugins-src/ui-app",
        "dst": "plugins-src/ui-app",
        "recursive": true,
        "exclude": [
          "node_modules"
        ]
      },
      {
        "src": "config/models",
        "dst": "models",
        "optional": true,
        "recursive": true
      },
      {
        "src": ".pair/assets/runtime/web",
        "dst": ".pair/assets/runtime/web",
        "recursive": true
      },
      {
        "src": ".pair/assets/runtime/bridge_node.js",
        "dst": ".pair/assets/runtime/bridge_node.js"
      },
      {
        "src": ".pair/assets/runtime/cordis.bundle.js",
        "dst": ".pair/assets/runtime/cordis.bundle.js"
      }
    ]
  },
  "stripSecrets": {
    "fields": [
      "apiKey",
      "APIKey",
      "api_password",
      "secret",
      "token"
    ],
    "files": [
      "config/settings.json",
      "config/mcp.json",
      "config/models.json"
    ]
  }
}