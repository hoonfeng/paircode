{
  "version": "1.0.3",
  "appName": "PairCode IDE",
  "description": "AI-Powered Code Companion",
  "company": "PairCode",
  "copyright": "Copyright (C) 2026 PairCode",
  "icon": "assets/icon.png",
  "frontendDir": "cmd/companion/web-ui",
  "skipBuildFrontend": false,
  "mainPkg": "./cmd/companion",
  "output": "companion.exe",
  "secrets": {
    "fields": [
      "apiKey",
      "APIKey",
      "api_password",
      "secret",
      "token"
    ],
    "files": [
      "config/settings.json",
      "config/mcp.json"
    ]
  },
  "dist": {
    "outputDir": "release",
    "dirName": "PairCode",
    "include": [
      {
        "src": "config/models.json",
        "dst": "config/models.json",
        "optional": true,
        "recursive": false
      },
      {
        "src": "config/settings.template.json",
        "dst": "config/settings.json",
        "optional": true,
        "recursive": false
      },
      {
        "src": "config/mcp.json",
        "dst": "config/mcp.json",
        "optional": true,
        "recursive": false
      },
      {
        "src": "config/skills",
        "dst": "config/skills",
        "optional": true,
        "recursive": true
      },
      {
        "src": "config/roles",
        "dst": "config/roles",
        "optional": true,
        "recursive": true
      },
      {
        "src": "config/philosophy",
        "dst": "config/philosophy",
        "optional": true,
        "recursive": true
      },
      {
        "src": "assets/icon.svg",
        "dst": "assets/icon.svg",
        "optional": true,
        "recursive": false
      },
      {
        "src": "assets/icon.png",
        "dst": "assets/icon.png",
        "optional": true,
        "recursive": false
      },
      {
        "src": "assets/icon64.png",
        "dst": "assets/icon64.png",
        "optional": true,
        "recursive": false
      },
      {
        "src": "assets/icon128.png",
        "dst": "assets/icon128.png",
        "optional": true,
        "recursive": false
      },
      {
        "src": "fonts",
        "dst": "fonts",
        "optional": true,
        "recursive": true
      },
      {
        "src": "lib/libSkiaSharp.dll",
        "dst": "lib/libSkiaSharp.dll",
        "optional": true,
        "recursive": false
      },
      {
        "src": "bin/tesseract",
        "dst": "bin/tesseract",
        "optional": true,
        "recursive": true
      },
      {
        "src": "bin/config/models.json",
        "dst": "bin/config/models.json",
        "optional": true,
        "recursive": false
      },
      {
        "src": "bin/config/onnx",
        "dst": "bin/config/onnx",
        "optional": true,
        "recursive": true
      },
      {
        "src": "bin/headless-check.js",
        "dst": "bin/headless-check.js",
        "optional": true,
        "recursive": false
      },
      {
        "src": "cmd/companion/models",
        "dst": "models",
        "optional": true,
        "recursive": true
      }

    ]
  },
  "tools": {
    "windres": "windres",
    "ffmpeg": "ffmpeg",
    "go": "go",
    "npm": "npm"
  }
}